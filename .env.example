# App
APP_NAME=Presensi Siswa Rajasa
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Jakarta

# Nginx
NGINX_PORT=8080

# Frontend
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8080/api

# Admin Contact (untuk fitur Lupa Password di halaman login)
VITE_ADMIN_WA=6281234567890
VITE_ADMIN_EMAIL=admin@rajasa.sch.id

# Backend
BACKEND_PORT=9000

# Database
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=sistem_presensi_siswa_qr
DB_USERNAME=root
DB_PASSWORD=

# Auth
SESSION_SECRET=change_me_for_local_dev
ACCESS_TOKEN_TTL_MINUTES=720

# Presensi
PRESENSI_SESSION_TIMEOUT_MINUTES=20
PRESENSI_MAX_JAM_PER_SESI=3

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With

# Linux/macOS permission helper:
# Set these values to match your host user:
# UID=$(id -u)
# GID=$(id -g)
UID=1000
GID=1000
# Supabase Storage (foto profil persisten — survive Render redeploy)
# Setup: supabase.com → New project → Storage → New bucket (public)
# Key: Settings → API Keys → service_role (secret)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_service_role_key_here
SUPABASE_BUCKET=presensi-rajasa
