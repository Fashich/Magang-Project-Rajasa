### --- [ GLOBAL & OS ] --- ###
.DS_Store
Thumbs.db
*.log
*.tmp
*.swp

### --- [ IDE / EDITORS ] --- ###
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

### --- [ BACKEND (Laravel / PHP Modular) ] --- ###
# Karena kamu pakai DI manual/modular, pastikan folder vendor diabaikan
**/vendor/
.env
.env.backup
.env.production
.phpunit.result.cache
.phpunit.cache

# Folder storage Laravel (jika ada komponen yang menggunakannya)
/backend/storage/*.key
/backend/storage/framework/cache/data/*
/backend/storage/framework/views/*.php
/backend/storage/framework/sessions/*
/backend/storage/logs/*
/backend/database/data/*.csv
/backend/database/data/*.sqlite
/backend/database/data/*.xlsx

# Jika kamu menggunakan PHP-DI atau library DI yang meng-compile container
/backend/cache/

### --- [ FRONTEND (React / Node) ] --- ###
**/node_modules/
/frontend/build/
/frontend/dist/
/frontend/.env.local
/frontend/.env.development.local
/frontend/.env.test.local
/frontend/.env.production.local
/frontend/node_modules/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

### --- [ DOCKER & INFRA ] --- ###
# Abaikan data database lokal agar tidak masuk ke Git
/docker/mysql_data/
/docker/redis_data/

# Jika ada file docker-compose lokal yang spesifik untuk mesinmu saja
docker-compose.override.yml

### --- [ SECURITY ] --- ###
# Jangan pernah commit file kunci/sertifikat
*.pem
*.key
auth.json
